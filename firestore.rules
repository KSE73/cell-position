rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // 조회는 공개
    match /cellGroups/{g}/electrodes/{e} {
      allow read: if true;
      allow write: if request.resource.data.updatedBy is string
                   && request.resource.data.updatedBy.size() > 0;
    }
    // 이력: 생성만 허용, 수정·삭제 금지 (훼손 방지)
    match /editHistory/{h} {
      allow read: if true;
      allow create: if request.resource.data.editedBy is string
                    && request.resource.data.editedBy.size() > 0;
      allow update, delete: if false;
    }
    // 이력 번호 채번용 카운터
    match /counters/{c} {
      allow read: if true;
      allow write: if true;
    }
    match /users/{u} { allow read: if true; allow write: if true; }
  }
}
